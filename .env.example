# Application Environment
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Security
SECRET_KEY=change-this-in-production-use-a-secure-random-32-byte-hex
API_KEY_HEADER=X-API-Key

# Persistence
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
CHECKPOINTER_DB_PATH=./data/checkpoints.db

# LLM Configuration (Ollama / Local)
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:3b-instruct
LLM_TIMEOUT_SECONDS=60.0
LLM_FALLBACK_MOCK=true

# Execution & Policy Limits (Tuned for 8 GB RAM)
MAX_PLAN_STEPS=8
MAX_STEP_RETRIES=2
MAX_REPLANS=2
DEFAULT_TASK_TIMEOUT_SECONDS=300.0
TOOL_TIMEOUT_SECONDS=15.0
APPROVAL_TIMEOUT_SECONDS=1800.0
